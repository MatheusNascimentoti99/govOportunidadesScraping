# ──────────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores.
# O .env nunca deve ser commitado no git.
# ──────────────────────────────────────────────────────────────────

# ── PostgreSQL (docker-compose local) ─────────────────────────────
# Valores padrão do docker-compose.yml — não altere para dev local.
DATABASE_URL=postgresql://govuser:govpassword@postgres:5432/govdb

# ── API FastAPI ────────────────────────────────────────────────────
# Para dev local (docker-compose), use http://localhost:8000
API_BASE_URL=http://localhost:8000

# Chave secreta compartilhada entre a API e o Scrapy.
# Gere uma forte com: openssl rand -hex 32
API_SECRET_KEY=troque-por-uma-chave-secreta-forte

# ── SMTP – E-mails de confirmação e notificação ────────────────────
# Para usar Gmail, gere uma "Senha de App" em myaccount.google.com/apppasswords
SCRAPY_MAIL_HOST=smtp.gmail.com
SCRAPY_MAIL_PORT=587
SCRAPY_MAIL_USER=seu.email@gmail.com
SCRAPY_MAIL_PASS=SUA_SENHA_DE_APP_GMAIL
SCRAPY_MAIL_FROM=seu.email@gmail.com

# ── OpenRouter – Resumo de editais via LLM ────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=deepseek/deepseek-r1-0528:free
OPENROUTER_MAX_TEXT_LENGTH=4000